{
	"schemaVersion": 1,
	"id": "realcars",
	"version": "${version}",
	"name": "RealCars",
	"description": "Gerçek hayattaki arabaları Minecraft'a getiren araba modu: motor sesi, km/saat göstergesi, dönen tekerlekler, toz efektleri, parça craftlama ve modifiye sistemi.",
	"authors": [
		"pisanadam"
	],
	"contact": {
		"sources": "https://github.com/pisanadam/car-mod-26.2"
	},
	"license": "MIT",
	"icon": "assets/realcars/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.pisanadam.realcars.RealCars"
		],
		"client": [
			"com.pisanadam.realcars.client.RealCarsClient"
		]
	},
	"mixins": [
		{
			"config": "realcars.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "${mc}",
		"java": ">=17",
		"fabric-api": "*"
	}
}
